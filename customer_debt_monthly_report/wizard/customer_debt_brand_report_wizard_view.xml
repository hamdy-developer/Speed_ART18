<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="customer_debt_brand_report_wizard_view_form" model="ir.ui.view">
            <field name="name">customer.debt.brand.report.wizard.form</field>
            <field name="model">customer.debt.brand.report.wizard</field>
            <field name="arch" type="xml">
                <form string="Customer Debt By Brand Report">
                    <group>
                        <group>
                            <field name="date_from"/>
                            <field name="report_by" widget="radio" options="{'horizontal': true}"/>
                            <field name="number_of_months"/>
                        </group>
                        <group>
                            <field name="employee_ids" widget="many2many_tags" invisible="report_by != 'employee'"/>
                            <field name="brand_ids" widget="many2many_tags" invisible="report_by != 'brand'"/>
                        </group>
                    </group>
                    <footer>
                        <button name="action_print_xlsx" string="Print Excel" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="customer_debt_brand_report_wizard_action" model="ir.actions.act_window">
            <field name="name">Customer Debt By Brand</field>
            <field name="res_model">customer.debt.brand.report.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <menuitem id="menu_customer_debt_brand_report"
                  name="Customer Debt By Brand"
                  parent="account.menu_finance_reports"
                  action="customer_debt_brand_report_wizard_action"
                  sequence="101"/>

        <menuitem id="menu_customer_debt_brand_report_sales"
                  name="Customer Debt By Brand"
                  parent="sale.menu_sale_report"
                  action="customer_debt_brand_report_wizard_action"
                  sequence="101"/>
    </data>
</odoo>
